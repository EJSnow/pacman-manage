#########################################
# pacman-manage
#########################################
# A little utility to assist with package management on Arch-based systems.

# Functions included:
#
# * Browse all installed packages with filters such as explicitly installed,
#   orphaned dependencies, etc. Packages can be uninstalled from the menu.
# * Browse/install packages from repositories and aur (via yay)
# * Clear caches (including AUR-related data)
#
# Uses Fzf for browsing package lists. All operations use yay (because AUR).

fzfShow() {
	# Simple function to make it way easier to show things in fzf
	# Pass the arguments for pacman/yay:
	#	$1 = list operation
	#	$2 = preview operation
	#	$3 = action operation
	clear
	fzfOptions="--layout=reverse-list \
				--preview-window=right:70% \
				--multi \
				--track \
				--cycle \
				--color base16"
	listArg="-$1"
	previewArg="-$2"
	actionArg="-$3"
	packages=$(yay $listArg | LC_ALL=C sort -u | fzf $fzfOptions --preview "yay $previewArg {}")

	if [[ -n "$packages" ]]; then
		packages=$(echo $packages)
		exec packageOp
	fi
	menu $type
}

menu() {
	clear
	printf '\e[0m'
	type=$1
	options=()
	optionsText=()
	option=
	printf '\e[1m'; echo "Pacman Management"
	printf '\e[0m'; echo "-----------------"
	echo ""
	case $type in
		main)
			options=("installed" "repos" "orphans" "cache" "exit")
			optionsText=("➔ Show installed packages" "➔ Browse repositories/AUR" "➔ Manage orphaned dependencies" "➔ Clear Pacman cache" "✕ Exit")
			option=$(list "Choose an action" "${optionsText[@]}")
			echo ""
			case ${options[$option]} in
				installed) menu installed;;
				repos) menu repos;;
				orphans) menu orphans;;
				cache) menu clearCache;;
				exit) exit 0;
			esac
			;;
		installed)
			options=("all" "explicit" "foreign" "back")
			optionsText=("➔ Show all installed packages" "➔ Show explicitly installed packages" "➔ Show external (e.g. AUR) packages" "← Back")
			option=$(list "Choose an action" "${optionsText[@]}")
			echo ""
			case ${options[$option]} in
				all) fzfShow Qq Qi Rns;;
				explicit) fzfShow Qqe Qi Rns;;
				foreign) fzfShow Qqm Qi Rns;;
				back) menu main;;
			esac
			;;
		repos)
			options=("both" "reposOnly" "aurOnly" "back")
			optionsText=("➔ Browse repos and AUR" "➔ Browse repos only" "➔ Browse AUR only" "← Back")
			option=$(list "Choose an action" "${optionsText[@]}")
			echo ""
			case ${options[$option]} in
				both) fzfShow Slq Si Syu;;
				reposOnly) fzfShow SlqN Si Syu;;
				aurOnly) fzfShow Slqa Si Syu;;
				back) menu main;;
			esac
			;;
		orphans)
			options=("view" "remove" "back")
			optionsText=("➔ View orphaned dependencies" "➔ Remove all orphans" "← Back")
			option=$(list "Choose an action" "${optionsText[@]}")
			echo ""
			case ${options[$option]} in
				view) fzfShow Qdtq Qi Rns;;
				remove) exec removeOrphans;;
				back) menu main;;
			esac
			;;
		clearCache)
			options=("clear" "clearAll" "back")
			optionsText=("➔ Clear cache (only uninstalled packages)" "➔ Clear ALL cached packages" "← Back")
			option=$(list "Choose an action" "${optionsText[@]}")
			echo ""
			case ${options[$option]} in
				clear) exec clearCache;;
				clearAll) exec clearAllCache;;
				back) menu main;;
			esac
			;;
	esac
}

exec() {
	# Executes some predefined commands and prompts you to press Enter afterwards
	command=$1
	code=0
	clear
	printf '\e[1;36mExecuted: '
	case $command in
		removeOrphans)
			printf 'Remove all orphan dependencies\e[0m\n'
			if pacman -Qdtq; then
				pacman -Qdtq | pacman -Rns -
				code=$?
			else
				echo "No orphaned dependencies found!"
				code=0
			fi
		;;
		clearCache)
			printf 'Clear pacman cache (uninstalled packages)\e[0m\n'
			if sudo ls /var/cache/pacman/pkg/*/ >/dev/null 2>&1 ; then
				echo "Directories found within pacman cache. Cleaning up..."
				sudo rm -rf /var/cache/pacman/pkg/*/
			else
                echo "No directories within pacman cache."
			fi
			printf "\e[1;36mExecuting yay -Sc\e[0m\n"
			yay -Sc
			code=$?
			;;
		clearAllCache)
			printf "Clear pacman cache (ALL packages)\e[0m\n"
			echo "Checking for directories within pacman cache..."
			if sudo ls /var/cache/pacman/pkg/*/ >/dev/null 2>%1 ; then
				echo "Directories found within pacman cache. Cleaning up..."
				sudo rm -rf /var/cache/pacman/pkg/*/
			else
                echo "No directories within pacman cache."
			fi
			printf "\e[1;36mExecuting yay -Scc\e[0m\n"
			yay -Scc
			code=$?
			;;
		packageOp)
			printf "yay $actionArg $packages\e[0m\n"
			yay $actionArg $packages # I'm abusing Bash's default global variables so hard
			code=$?
	esac
	echo ""; printf '\e[1;32m\e[?25l'
	[[ $code == 0 ]] && printf "Operation completed successfully.\e[0;1m\n" || printf "\e[33mOperation failed.\e[0;1m\n"
	read -p "Press Enter to return to menu."
	menu $type
}

menu main
